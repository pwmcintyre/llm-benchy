# Public models usually work without a token. Set this only if your chosen model requires auth.
HUGGING_FACE_HUB_TOKEN=

# Safe default for 12GB VRAM. You can switch to a larger/quantized Qwen model later.
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
SERVED_MODEL_NAME=qwen-local

# Tuning knobs for RTX 4070 12GB.
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=8
DTYPE=auto

# Optional for quantized checkpoints, e.g. awq or gptq.
QUANTIZATION=
